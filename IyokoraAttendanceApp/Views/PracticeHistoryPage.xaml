<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.PracticeHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    xmlns:models="clr-namespace:IyokoraAttendanceApp.Models"
    x:DataType="vm:PracticeHistoryViewModel"
    x:Name="Root"
    Title="過去の練習">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Magenta}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               Margin="16,12,16,0" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Practices}" Margin="16,12,16,16">
                <CollectionView.EmptyView>
                    <Label Text="過去の練習データはありません。" HorizontalOptions="Center" Margin="0,40,0,0"
                           TextColor="{StaticResource Gray500}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Practice">
                        <Grid Padding="0,6">
                            <Border Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Date, StringFormat='{0:yyyy年M月d日(ddd)}'}"
                                               FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Title}"
                                               IsVisible="{Binding Title, Converter={StaticResource StringToBoolConverter}}" />
                                        <Label Text="{Binding Place, StringFormat='📍 {0}'}"
                                               IsVisible="{Binding Place, Converter={StaticResource StringToBoolConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding PiecesSummary, StringFormat='🎵 {0}'}"
                                               IsVisible="{Binding PiecesSummary, Converter={StaticResource StringToBoolConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="削除" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Magenta}"
                                            IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsAdmin}"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeletePracticeCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
