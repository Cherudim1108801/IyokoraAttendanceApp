<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.SchedulePollPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    xmlns:models="clr-namespace:IyokoraAttendanceApp.Models"
    x:DataType="vm:SchedulePollViewModel"
    x:Name="Root"
    Title="日程投票">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="10">
            <Button Text="＋ 候補日を追加" Command="{Binding ToggleAddPanelCommand}" IsVisible="{Binding IsAdmin}" />

            <Border IsVisible="{Binding IsAddPanelVisible}" Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="日付" FontAttributes="Bold" />
                    <DatePicker Date="{Binding NewDate}" />

                    <Label Text="時間帯" FontAttributes="Bold" />
                    <Picker
                        ItemsSource="{Binding TimeOfDayOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding NewTimeOfDay}" />

                    <Button Text="この内容で登録" Command="{Binding AddCandidateCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Magenta}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Candidates}" Margin="16,0,16,16">
                <CollectionView.EmptyView>
                    <Label Text="登録されている日程候補はありません。" HorizontalOptions="Center" Margin="0,40,0,0"
                           TextColor="{StaticResource Gray500}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleCandidateDisplay">
                        <Grid Padding="0,6">
                            <Border Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Candidate.Date, StringFormat='{0:yyyy年M月d日(ddd)}'}"
                                                   FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                                            <Border Padding="8,2" Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                                   BackgroundColor="{StaticResource Primary}">
                                                <Label Text="{Binding TimeOfDayLabel}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Button Grid.Column="1" Text="削除" FontSize="12"
                                                BackgroundColor="Transparent" TextColor="{StaticResource Magenta}"
                                                IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsAdmin}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteCandidateCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="参加"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.VoteAttendingCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsAttendingSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#3EC1A4" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Grid.Column="1" Text="不参加"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.VoteNotAttendingCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsNotAttendingSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#E0607A" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>

                                    <Label FontSize="12" TextColor="{StaticResource Gray500}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="参加 " />
                                                <Span Text="{Binding AttendingCount}" />
                                                <Span Text=" / 不参加 " />
                                                <Span Text="{Binding NotAttendingCount}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
