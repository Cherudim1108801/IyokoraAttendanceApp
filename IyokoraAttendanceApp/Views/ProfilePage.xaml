<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    x:DataType="vm:ProfileViewModel"
    Title="プロフィール">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="名前" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="例：山田 太郎" />

            <Label Text="パート" FontAttributes="Bold" />
            <Picker
                ItemsSource="{Binding PartOptions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedPart}" />

            <Label Text="役割" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="管理者は曲・練習予定の追加ができます。一般団員は出欠登録のみ行え、その他は閲覧のみです。" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker
                ItemsSource="{Binding RoleOptions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedRole}" />

            <Label Text="ログインID" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="他の端末でこのアプリを使う場合は、このIDでログインしてください。" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Label Text="{Binding LoginId}" FontSize="18" FontAttributes="Bold" CharacterSpacing="1" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsLegacyLoginId}">
                <Label Text="このログインIDは旧形式です。新しい形式のIDに更新することをおすすめします。"
                       FontSize="12" TextColor="{StaticResource Magenta}" />
                <Button Text="ログインIDを更新する" Command="{Binding ReissueLoginIdCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding ReissuedLoginId, Converter={StaticResource StringToBoolConverter}}"
                    Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFF6E0, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="新しいログインID" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding ReissuedLoginId}" FontSize="20" FontAttributes="Bold" CharacterSpacing="1" />
                </VerticalStackLayout>
            </Border>

            <Label Text="曲ごとのパート担当" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="所属パートに内部分割（上・下など）が設定されている曲のみ表示されます。" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Label Text="該当する曲はありません。" FontSize="12" TextColor="{StaticResource Gray500}"
                   IsVisible="{Binding PiecePartInputs.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=Invert}" />

            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding PiecePartInputs}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PiecePartSelectionInput">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8">
                            <Label Text="{Binding PieceTitle}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" WidthRequest="140"
                                    ItemsSource="{Binding SubPartOptions}"
                                    SelectedItem="{Binding SelectedSubPart}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Magenta}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label
                Text="{Binding SavedMessage}"
                TextColor="#3EC1A4"
                IsVisible="{Binding SavedMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button Text="保存" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,20,0,20" IsVisible="{Binding IsAdmin}" />

            <Label Text="管理者メニュー" FontSize="13" TextColor="{StaticResource Gray500}" IsVisible="{Binding IsAdmin}" />
            <Button Text="団員管理" Command="{Binding OpenMembersCommand}" IsVisible="{Binding IsAdmin}" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,20,0,20" />

            <Label Text="この端末を別の人が使う場合" FontSize="13" TextColor="{StaticResource Gray500}" />
            <Button Text="別のプロフィールを使う" Command="{Binding SwitchProfileCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Magenta}" BorderColor="{StaticResource Magenta}" BorderWidth="1" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
