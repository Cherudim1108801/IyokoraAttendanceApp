<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    xmlns:models="clr-namespace:IyokoraAttendanceApp.Models"
    x:DataType="vm:ScheduleViewModel"
    x:Name="Root"
    Title="練習予定">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="10">
            <Button Text="＋ 練習予定を追加" Command="{Binding ToggleAddPanelCommand}" IsVisible="{Binding IsAdmin}" />

            <Border IsVisible="{Binding IsAddPanelVisible}" Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="日付" FontAttributes="Bold" />
                    <DatePicker Date="{Binding NewDate}" />

                    <Label Text="タイトル（任意）" FontAttributes="Bold" />
                    <Entry Text="{Binding NewTitle}" Placeholder="例：定期練習" />

                    <Label Text="場所（任意）" FontAttributes="Bold" />
                    <Entry Text="{Binding NewPlace}" Placeholder="例：市民会館 音楽室" />

                    <Label Text="開始時刻（任意）" FontAttributes="Bold" />
                    <TimePicker Time="{Binding NewStartTime, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" Format="HH:mm" />

                    <Label Text="終了時刻（任意）" FontAttributes="Bold" />
                    <TimePicker Time="{Binding NewEndTime, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" Format="HH:mm" />

                    <Label Text="タイムスケジュール（任意・10分単位）" FontAttributes="Bold" Margin="0,8,0,0" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding NewTimelineItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TimelineItemInput">
                                <Border Padding="10" Stroke="Transparent" StrokeShape="RoundRectangle 8"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="開始" FontSize="12" />
                                        <TimePicker Time="{Binding StartTime, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" Format="HH:mm" />
                                        <Label Text="終了" FontSize="12" />
                                        <TimePicker Time="{Binding EndTime, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" Format="HH:mm" />
                                        <Label Text="内容" FontSize="12" />
                                        <Entry Text="{Binding Content}" Placeholder="例：基礎合奏" />
                                        <Button Text="この項目を削除" FontSize="12"
                                                BackgroundColor="Transparent" TextColor="{StaticResource Magenta}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveTimelineItemCommand}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="＋ タイムスケジュールの項目を追加" Command="{Binding AddTimelineItemCommand}" />

                    <Label Text="練習する曲（任意）" FontAttributes="Bold" Margin="0,8,0,0" />
                    <Label Text="登録されている曲はありません。「曲」タブから登録できます。" FontSize="12" TextColor="{StaticResource Gray500}"
                           IsVisible="{Binding PieceInputs.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=Invert}" />

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding PieceInputs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PieceSelectionInput">
                                <Grid ColumnDefinitions="Auto,*" Padding="0,4" ColumnSpacing="8">
                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                    <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding NewRequiresKeyPickup}" />
                        <Label Grid.Column="1" Text="鍵の受け取りが必要" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="この内容で登録" Command="{Binding AddPracticeCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Magenta}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Practices}" Margin="16,0,16,16">
                <CollectionView.EmptyView>
                    <Label Text="登録されている練習予定はありません。" HorizontalOptions="Center" Margin="0,40,0,0"
                           TextColor="{StaticResource Gray500}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Practice">
                        <Grid Padding="0,6">
                            <Border Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Date, StringFormat='{0:yyyy年M月d日(ddd)}'}"
                                               FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Title}"
                                               IsVisible="{Binding Title, Converter={StaticResource StringToBoolConverter}}" />
                                        <Label Text="{Binding TimeRangeSummary, StringFormat='🕒 {0}'}"
                                               IsVisible="{Binding TimeRangeSummary, Converter={StaticResource StringToBoolConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding Place, StringFormat='📍 {0}'}"
                                               IsVisible="{Binding Place, Converter={StaticResource StringToBoolConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding PiecesSummary, StringFormat='🎵 {0}'}"
                                               IsVisible="{Binding PiecesSummary, Converter={StaticResource StringToBoolConverter}}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="削除" FontSize="12"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Magenta}"
                                            IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsAdmin}"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeletePracticeCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
