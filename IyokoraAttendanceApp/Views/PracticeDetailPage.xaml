<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.PracticeDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    xmlns:models="clr-namespace:IyokoraAttendanceApp.Models"
    x:DataType="vm:PracticeDetailViewModel"
    Title="練習の詳細">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Practice.Date, StringFormat='{0:yyyy年M月d日(ddd)}'}"
                           FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Practice.Title}"
                           IsVisible="{Binding Practice.Title, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding Practice.Place, StringFormat='📍 {0}'}"
                           IsVisible="{Binding Practice.Place, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Practice.PiecesSummary, StringFormat='🎵 {0}'}"
                           IsVisible="{Binding Practice.PiecesSummary, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding AttendanceSummaryLabel}" />
                </VerticalStackLayout>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Magenta}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <!-- 自分の出欠 -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="あなたの出欠" FontSize="16" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="参加"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.Attending}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsAttendingSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#3EC1A4" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="不参加"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.NotAttending}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsNotAttendingSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E0607A" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="未定"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.Undecided}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsUndecidedSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <!-- パート別 メンバー出欠一覧 -->
                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding PartGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PartGroup">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Label}" TextColor="{Binding Color}"
                                           FontAttributes="Bold" FontSize="16" />
                                    <Label Grid.Column="1">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AttendingCount}" FontAttributes="Bold" />
                                                <Span Text=" / " />
                                                <Span Text="{Binding TotalCount}" />
                                                <Span Text=" 人" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>

                                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Attendees}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:AttendeeItem">
                                            <Grid ColumnDefinitions="*,Auto" Padding="8,6">
                                                <Label Text="{Binding Name}" />
                                                <Label Grid.Column="1" Text="{Binding StatusLabel}"
                                                       TextColor="{Binding StatusColor}" FontAttributes="Bold" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
