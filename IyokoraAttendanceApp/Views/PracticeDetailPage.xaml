<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="IyokoraAttendanceApp.Views.PracticeDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IyokoraAttendanceApp.ViewModels"
    xmlns:models="clr-namespace:IyokoraAttendanceApp.Models"
    x:DataType="vm:PracticeDetailViewModel"
    x:Name="Root"
    Title="練習の詳細">

    <Grid>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Practice.Date, StringFormat='{0:yyyy年M月d日(ddd)}'}"
                           FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Practice.Title}"
                           IsVisible="{Binding Practice.Title, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding Practice.Place, StringFormat='📍 {0}'}"
                           IsVisible="{Binding Practice.Place, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Practice.PiecesSummary, StringFormat='🎵 {0}'}"
                           IsVisible="{Binding Practice.PiecesSummary, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding AttendanceSummaryLabel}" />
                </VerticalStackLayout>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Magenta}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <!-- 自分の出欠 -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="あなたの出欠" FontSize="16" FontAttributes="Bold" />
                    <Label Text="過去の練習のため、出欠は変更できません。" FontSize="12" TextColor="{StaticResource Gray500}"
                           IsVisible="{Binding IsAttendanceEditable, Converter={StaticResource InvertedBoolConverter}}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsEnabled="{Binding IsAttendanceEditable}">
                        <Button Text="参加"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.Attending}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsAttendingSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#3EC1A4" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="不参加"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.NotAttending}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsNotAttendingSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E0607A" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="未定"
                                Command="{Binding SetMyStatusCommand}" CommandParameter="{x:Static models:AttendanceStatus.Undecided}"
                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Black}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsUndecidedSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <!-- パート別 参加人数カード -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="パート別 参加人数" FontSize="16" FontAttributes="Bold" />
                    <Label Text="カードをタップすると参加者の名前を確認できます" FontSize="12" TextColor="{StaticResource Gray500}" />

                    <CollectionView ItemsSource="{Binding PartSummaries}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PartSummary">
                                <Border Padding="14" Stroke="Transparent" StrokeShape="RoundRectangle 14"
                                       BackgroundColor="{Binding CardBackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowPartDetailCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Label}" TextColor="{StaticResource Black}"
                                               FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding AttendingCount}" FontSize="40" FontAttributes="Bold" />
                                        <Label Text="{Binding CountLabel}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 曲ごとの参加人数（○表示） -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasSongParticipations}">
                    <Label Text="曲ごとの参加人数" FontSize="16" FontAttributes="Bold" />
                    <Label Text="○の色はパート、「上」「下」は曲内の分割担当を表します" FontSize="12" TextColor="{StaticResource Gray500}" />

                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding SongParticipations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SongParticipation">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Dots}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ParticipationDot">
                                                <Border WidthRequest="30" HeightRequest="30" Margin="{Binding Margin}"
                                                        Stroke="Transparent" StrokeShape="RoundRectangle 15"
                                                        BackgroundColor="{Binding Color}">
                                                    <Label Text="{Binding SubLabel}" TextColor="{StaticResource Black}"
                                                           FontAttributes="Bold" FontSize="12"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="★" TextColor="#F5A623" FontSize="14"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsFeatured}" />
                                        <Label Grid.Column="1" Text="🎵 録音を聴く" FontSize="13" TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding HasRecordingUrl}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenRecordingCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="1" Text="録音リンク未登録" FontSize="12" TextColor="{StaticResource Gray500}"
                                               IsVisible="{Binding HasRecordingUrl, Converter={StaticResource InvertedBoolConverter}}" />
                                        <HorizontalStackLayout Grid.Column="2"
                                                IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsAdmin}">
                                            <Button Text="★ 注目に設定" FontSize="12"
                                                    BackgroundColor="Transparent" TextColor="{StaticResource Gray500}"
                                                    IsVisible="{Binding CanToggleFeaturedOn}"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleRecordingFeaturedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="★ 注目解除" FontSize="12"
                                                    BackgroundColor="Transparent" TextColor="#F5A623"
                                                    IsVisible="{Binding CanToggleFeaturedOff}"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleRecordingFeaturedCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Column="3" Text="編集" FontSize="12"
                                                BackgroundColor="Transparent" TextColor="{StaticResource Gray500}"
                                                IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsAdmin}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditRecordingCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    <!-- パート詳細モーダル -->
    <Grid IsVisible="{Binding IsPartModalVisible}" BackgroundColor="#80000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ClosePartModalCommand}" />
        </Grid.GestureRecognizers>

        <Border Padding="20" Stroke="Transparent" StrokeShape="RoundRectangle 16"
               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
               HorizontalOptions="Center" VerticalOptions="Center" Margin="30" MaximumWidthRequest="360">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding SelectedPartSummary.Label}" TextColor="{Binding SelectedPartSummary.Color}"
                       FontSize="20" FontAttributes="Bold" />
                <Label Text="{Binding SelectedPartSummary.CountLabel}" FontSize="14" TextColor="{StaticResource Gray500}" />
                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4,0,4" />

                <CollectionView ItemsSource="{Binding SelectedPartSummary.AttendeeNames}" MaximumHeightRequest="300">
                    <CollectionView.EmptyView>
                        <Label Text="参加予定のメンバーはいません。" TextColor="{StaticResource Gray500}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="16" Padding="0,6" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="閉じる" Command="{Binding ClosePartModalCommand}" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
